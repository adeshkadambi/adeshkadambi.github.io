---
import "../styles/global.css"
import { site } from "../data/site"

interface Props {
  title?: string
  description?: string
}

const { title, description = site.description } = Astro.props
const pageTitle = title ? `${title} | ${site.name}` : site.name
const path = Astro.url.pathname
const nav = [
  { href: "/posts/", label: "Writing" },
  { href: "/publications/", label: "Publications" },
  { href: "/projects/", label: "Projects" },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <script is:inline defer data-domain="adeshkadambi.github.io" src="https://plausible.io/js/script.js"></script>
    <script is:inline>
      // Runs before paint so there's no flash. A saved choice wins; otherwise follow the system.
      ;(() => {
        const media = matchMedia("(prefers-color-scheme: dark)")
        const saved = () => {
          try {
            return localStorage.getItem("theme")
          } catch {
            return null
          }
        }
        const apply = () =>
          (document.documentElement.dataset.theme = saved() ?? (media.matches ? "dark" : "light"))
        apply()
        media.addEventListener("change", apply)
      })()
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">{site.name}</a>
      <nav>
        {
          nav.map(({ href, label }) => (
            <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>
              {label}
            </a>
          ))
        }
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" hidden>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </nav>
    </header>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".theme-toggle")!
      button.hidden = false
      button.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark"
        document.documentElement.dataset.theme = next
        try {
          localStorage.setItem("theme", next)
        } catch {}
      })
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <a href={`mailto:${site.email}`}>Email</a>
      {Object.entries(site.links).map(([label, href]) => <a href={href}>{label}</a>)}
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
